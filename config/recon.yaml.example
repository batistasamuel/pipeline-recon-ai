# Copie para config/recon.yaml se quiser limitar alguma ferramenta.
# O argumento --threads continua sendo o padrão das que não aparecerem aqui.
# A chave do Google AI Studio NÃO fica neste arquivo. Use GEMINI_API_KEY no ambiente.
# cloud:
#   model: gemini-flash-latest
threads: 50
tools:
  dnsx:
    threads: 50
  httpx:
    threads: 50
  nuclei:
    threads: 50
    rate_limit: 150
  amass:
    timeout_minutes: 5
